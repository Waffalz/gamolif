<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.moriket.MassSimulationModal">
    <children>
    <HBox>
        <Label text="Number of Iterations: " />
        <TextField fx:id="iterationField" text="100"/>
    </HBox>
    <HBox>
        <Label text="Number of Replications: " />
        <TextField fx:id="replicationField" text="3"/>
    </HBox>
    <Button fx:id="startButton" text="Start Mass Simulation" onAction="#handleStartButtonAction"/>
    </children>
    <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
